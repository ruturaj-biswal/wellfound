Databases:
MySQL, PostgreSQL, MongoDB, H2

DevOps:
Docker, Kubernetes, GitHub Actions, Jenkins, CI/CD

Tools:
Git, GitHub, Figma

Other:
Data Structures & Algorithms, OOP, SQL, problem solving

GitHub:
https://github.com/ruturaj-biswal

I'm highly interested in software engineering, full-stack development and
building products that solve real-world problems.

Thank you for considering my application.

Best regards,
Ruturaj Biswal
`;

  // ============================================================
  // 📊 COUNTERS
  // ============================================================

  let appliedCount = 0;
  let skippedCount = 0;
  let failedCount = 0;
  let scrollCount = 0;

  const processedButtons = new Set();

  // ============================================================
  // 🛠️ HELPER FUNCTIONS
  // ============================================================

  const log = (message, color = "white") => {
    console.log(
      `%c${message}`,
      `color:${color}; font-weight:bold;`
    );
  };

  const setReactInputValue = (element, value) => {
    if (!element) return false;

    try {
      const prototype =
        element instanceof HTMLTextAreaElement
          ? HTMLTextAreaElement.prototype
          : HTMLInputElement.prototype;

      const descriptor = Object.getOwnPropertyDescriptor(
        prototype,
        "value"
      );

      descriptor?.set?.call(element, value);

      element.dispatchEvent(
        new Event("input", {
          bubbles: true,
        })
      );

      element.dispatchEvent(
        new Event("change", {
          bubbles: true,
        })
      );

      return true;
    } catch (error) {
      console.warn("Could not set React input:", error);

      // Fallback
      try {
        element.value = value;

        element.dispatchEvent(
          new Event("input", { bubbles: true })
        );

        element.dispatchEvent(
          new Event("change", { bubbles: true })
        );

        return true;
      } catch {
        return false;
      }
    }
  };

  const closeModal = async () => {
    const closeBtn =
      document.querySelector(
        'button[data-test="closeButton"]'
      ) ||
      document.querySelector(
        'button[aria-label="Close"]'
      );

    if (closeBtn) {
      closeBtn.click();
      await delay(500);
      return true;
    }

    return false;
  };

  // ============================================================
  // 📍 RELOCATION / LOCATION QUESTIONS
  // ============================================================

  const handleRelocationQuestion = async () => {
    try {
      const radioGroups = document.querySelectorAll(
        'input[name="qualification.location.action"]'
      );

      if (radioGroups.length > 0) {
        /*
         * IMPORTANT:
         * We do NOT blindly choose an option.
         *
         * The script attempts to detect a clearly labelled
         * "Yes" / relocation-related option.
         */

        let selected = false;

        for (const radio of radioGroups) {
          const label =
            document.querySelector(
              `label[for="${radio.id}"]`
            )?.innerText?.trim()?.toLowerCase() || "";

          if (
            label.includes("yes") &&
            (
              label.includes("relocat") ||
              label.includes("move")
            )
          ) {
            radio.click();
            selected = true;

            log(
              "📍 Selected relocation option based on label",
              "orange"
            );

            break;
          }
        }

        if (!selected && radioGroups.length === 2) {
          log(
            "⚠️ Relocation question detected but no safe label match. Skipping automatic answer.",
            "orange"
          );

          return false;
        }
      }

      // Location dropdown
      const dropdownContainer =
        document.querySelector(
          "#form-input--qualification\\.location\\.locationId .select__control"
        );

      if (dropdownContainer) {
        dropdownContainer.click();

        log(
          "🔽 Opened location dropdown",
          "orange"
        );

        await delay(500);

        const options =
          document.querySelectorAll(
            ".select__menu-list [role='option']"
          );

        if (options.length > 0) {
          /*
           * We intentionally do not select an arbitrary location.
           * Selecting a random location could create an incorrect
           * application response.
           */

          log(
            "⚠️ Location dropdown detected. Manual selection recommended.",
            "orange"
          );

          return false;
        }
      }

      return true;
    } catch (error) {
      log(
        "❌ Error while handling relocation question",
        "red"
      );

      console.error(error);

      return false;
    }
  };

  // ============================================================
  // 🎯 CUSTOM QUESTIONS
  // ============================================================

  const inspectCustomQuestions = () => {
    const allGroups = document.querySelectorAll(
      '[data-test^="RadioGroup-customQuestionAnswers"]'
    );

    if (!allGroups.length) {
      return {
        found: false,
        unsafe: false,
      };
    }

    let unsafe = false;

    allGroups.forEach((group, index) => {
      const question =
        group.previousElementSibling?.innerText ||
        group.parentElement?.innerText ||
        "";

      const options =
        group.querySelectorAll(
          'input[type="radio"]'
        );

      log(
        `❓ Custom question ${index + 1}: ${question
          .trim()
          .slice(0, 150)}`,
        "dodgerblue"
      );

      log(
        `   Options detected: ${options.length}`,
        "gray"
      );

      /*
       * Your old code selected:
       *   2 options -> first
       *   3 options -> middle
       *
       * That can submit false information.
       *
       * So we detect the question and stop instead.
       */

      if (options.length > 0) {
        unsafe = true;

        options.forEach((option, optionIndex) => {
          const label =
            document.querySelector(
              `label[for="${option.id}"]`
            )?.innerText?.trim();

          if (label) {
            log(
              `   ${optionIndex + 1}. ${label}`,
              "gray"
            );
          }
        });
      }
    });

    return {
      found: true,
      unsafe,
    };
  };

  // ============================================================
  // 📝 APPLICATION TEXT
  // ============================================================

  const fillApplicationText = () => {
    const selectors = [
      'textarea:not([disabled])',
      'textarea',
      'textarea[placeholder*="cover" i]',
      'textarea[placeholder*="message" i]',
      'textarea[placeholder*="application" i]',
    ];

    let textarea = null;

    for (const selector of selectors) {
      textarea = document.querySelector(selector);

      if (textarea) {
        break;
      }
    }

    if (!textarea) {
      log(
        "⚠️ Application textarea not found",
        "orange"
      );

      return false;
    }

    const success = setReactInputValue(
      textarea,
      applicationText.trim()
    );

    if (success) {
      log(
        "📝 Application text filled",
        "purple"
      );
    }

    return success;
  };

  // ============================================================
  // ✅ CHECK APPLICATION SUCCESS
  // ============================================================

  const checkApplicationSuccess = async () => {
    const successTexts = [
      "application submitted",
      "application sent",
      "thanks for applying",
      "application received",
      "your application",
    ];

    const failureTexts = [
      "something went wrong",
      "failed to submit",
      "unable to submit",
      "error submitting",
    ];

    await delay(1500);

    const bodyText =
      document.body?.innerText?.toLowerCase() || "";

    for (const text of failureTexts) {
      if (bodyText.includes(text)) {
        return false;
      }
    }

    for (const text of successTexts) {
      if (bodyText.includes(text)) {
        return true;
      }
    }

    /*
     * If the modal disappeared after clicking Apply,
     * treat it as potentially successful.
     */

    const stillOpen =
      document.querySelector(
        'button[data-test="JobDescriptionSlideIn--SubmitButton"]'
      );

    return !stillOpen;
  };

  // ============================================================
  // 🔎 PROCESS JOB BATCH
  // ============================================================

  const processBatch = async () => {
    let buttons = [
      ...document.querySelectorAll(
        'button[data-test="LearnMoreButton"]'
      ),
    ];

    buttons = buttons.filter(
      (button) =>
        !processedButtons.has(button)
    );

    if (buttons.length === 0) {
      return false;
    }

    for (let i = 0; i < buttons.length; i++) {
      const learnMoreBtn = buttons[i];

      processedButtons.add(learnMoreBtn);

      const jobNumber =
        appliedCount +
        skippedCount +
        failedCount +
        1;

      try {
        learnMoreBtn.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        await delay(500);

        learnMoreBtn.click();

        log(
          `🔍 [${jobNumber}] Opened job modal`,
          "blue"
        );

        // --------------------------------------------------------
        // Wait for Apply button
        // --------------------------------------------------------

        const applyBtn =
          await waitForElement(
            'button[data-test="JobDescriptionSlideIn--SubmitButton"]',
            7000
          );

        if (!applyBtn) {
          log(
            "❌ Apply button not found",
            "red"
          );

          skippedCount++;

          await closeModal();

          continue;
        }

        // --------------------------------------------------------
        // Check relocation questions
        // --------------------------------------------------------

        if (applyBtn.disabled) {
          const relocationHandled =
            await handleRelocationQuestion();

          if (relocationHandled) {
            log(
              "✅ Location-related form handled",
              "green"
            );
          } else {
            log(
              "⏭️ Form requires a manual / unverified answer — skipping",
              "orange"
            );

            skippedCount++;

            await closeModal();

            continue;
          }
        }

        await delay(500);

        // --------------------------------------------------------
        // Custom questions
        // --------------------------------------------------------

        const customQuestionState =
          inspectCustomQuestions();

        if (customQuestionState.unsafe) {
          log(
            "⏭️ Job has custom questions. Script will not submit guessed answers.",
            "orange"
          );

          skippedCount++;

          await closeModal();

          continue;
        }

        // --------------------------------------------------------
        // Fill application message
        // --------------------------------------------------------

        fillApplicationText();

        await delay(1000);

        // --------------------------------------------------------
        // Re-check button
        // --------------------------------------------------------

        const latestApplyBtn =
          document.querySelector(
            'button[data-test="JobDescriptionSlideIn--SubmitButton"]'
          );

        if (!latestApplyBtn) {
          log(
            "⚠️ Apply button disappeared",
            "orange"
          );

          failedCount++;

          await closeModal();

          continue;
        }

        if (latestApplyBtn.disabled) {
          log(
            "⏭️ Apply button is still disabled",
            "orange"
          );

          skippedCount++;

          await closeModal();

          continue;
        }

        // --------------------------------------------------------
        // APPLY
        // --------------------------------------------------------

        latestApplyBtn.click();

        log(
          "🚀 Apply button clicked",
          "teal"
        );

        const successful =
          await checkApplicationSuccess();

        if (successful) {
          appliedCount++;

          log(
            "✅ Application submitted",
            "green"
          );
        } else {
          failedCount++;

          log(
            "❌ Could not verify application submission",
            "red"
          );
        }

        // --------------------------------------------------------
        // Close modal
        // --------------------------------------------------------

        await delay(800);

        if (await closeModal()) {
          log(
            "❎ Modal closed",
            "crimson"
          );
        }

        await delay(1000);
      } catch (error) {
        failedCount++;

        log(
          `❌ Error processing job #${jobNumber}`,
          "red"
        );

        console.error(error);

        await closeModal();

        await delay(1000);
      }
    }

    return true;
  };

  // ============================================================
  // 📜 INFINITE SCROLL
  // ============================================================

  const maxScrollsWithoutNewJobs = 10;

  log(
    "🚀 Starting customized Wellfound application workflow...",
    "limegreen"
  );

  log(
    "👤 Applicant: Ruturaj Biswal",
    "cyan"
  );

  while (
    scrollCount <
    maxScrollsWithoutNewJobs
  ) {
    const found = await processBatch();

    if (!found) {
      window.scrollTo({
        top: document.body.scrollHeight,
        behavior: "smooth",
      });

      log(
        "📜 Scrolling to load more jobs...",
        "darkcyan"
      );

      scrollCount++;

      await delay(2500);
    } else {
      // New jobs were found
      scrollCount = 0;
    }
  }

  // ============================================================
  // 🎉 SUMMARY
  // ============================================================

  log(
    "🎉 Wellfound auto-apply workflow finished!",
    "limegreen"
  );

  console.log(
    "%c==============================",
    "color: gray"
  );

  console.log(
    `%c✅ Jobs Applied: ${appliedCount}`,
    "color:#4CAF50; font-weight:bold;"
  );

  console.log(
    `%c⏭️ Jobs Skipped: ${skippedCount}`,
    "color:#FF9800; font-weight:bold;"
  );

  console.log(
    `%c❌ Jobs Failed/Unverified: ${failedCount}`,
    "color:#F44336; font-weight:bold;"
  );

  console.log(
    `%c🔎 Processed Job Buttons: ${processedButtons.size}`,
    "color:#2196F3; font-weight:bold;"
  );

  console.log(
    "%c==============================",
    "color: gray"
  );
})();
