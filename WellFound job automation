(async () => {
  "use strict";

  // ============================================================
  // 🚀 WELLFOUND AUTO-APPLY SCRIPT
  // 👤 Profile customized for Ruturaj Biswal
  // ============================================================

  const delay = (ms) =>
    new Promise((resolve) => setTimeout(resolve, ms));

  const waitForElement = async (selector, timeout = 7000) => {
    const start = Date.now();

    while (Date.now() - start < timeout) {
      const element = document.querySelector(selector);

      if (element) {
        return element;
      }

      await delay(100);
    }

    return null;
  };

  const waitForText = async (text, timeout = 5000) => {
    const start = Date.now();

    while (Date.now() - start < timeout) {
      if (document.body?.innerText?.includes(text)) {
        return true;
      }

      await delay(200);
    }

    return false;
  };

  // ============================================================
  // 👤 YOUR APPLICATION PROFILE
  // ============================================================

  const applicationText = `
Hello,

I'm Ruturaj Biswal, a B.Tech Computer Science student at NIST University, Odisha,
with hands-on experience in full-stack development and software engineering.

I have worked on multiple end-to-end software projects involving frontend,
backend, databases, APIs, and deployment. My primary focus is building
practical, scalable web applications and continuously improving my
problem-solving and software engineering skills.

My technical experience includes:

1. Full-stack web development using React.js, JavaScript, Tailwind CSS,
   Flask, Spring Boot and REST APIs.

2. Database experience with MySQL, PostgreSQL, MongoDB and H2.

3. DevOps and deployment experience with Docker, Kubernetes, GitHub Actions,
   Jenkins and CI/CD pipelines.

4. Strong understanding of Java, OOP, SQL, DSA and backend development.

5. Experience building and integrating APIs, authentication flows,
   responsive user interfaces and database-driven applications.

Projects include:

• RailSaarthi – Smart Railway Assistant
  React.js, Tailwind CSS, Spring Boot, PostgreSQL and REST APIs.
  Features include train search, source/destination station search,
  date-based search and backend integration.

• Medical / Healthcare Application
  React, Flask and MySQL with features such as telemedicine,
  hospital discovery, digital health records, multilingual support
  and health-related assistance.

• E-commerce Application
  React frontend with Spring Boot backend and MongoDB.

I have also gained internship experience in software development and have
worked on real-world development tasks involving frontend, backend and
